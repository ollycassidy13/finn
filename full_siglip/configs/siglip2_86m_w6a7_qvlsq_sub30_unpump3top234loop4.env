# SigLIP2-86M W6A7 sub-30ms VCK190 build recipe.
#
# Usage:
#   source full_siglip/configs/siglip2_86m_w6a7_qvlsq_sub30_unpump3top234loop4.env
#   bash full_siglip/run_siglip2_86m_finn_estimate_from_qonnx.sh
#   bash full_siglip/run_siglip2_86m_dcp_from_estimate.sh
#
# The DCP that passed the audit was built at 3.999 ns with the folding config
# below and the pumped-compute exclusions below. Keep both together: the
# build_static pumped-compute pass runs after folding-config application.

export QONNX="full_siglip/build/static_qat_siglip2_86m_patch16_224_w6a7_qvlsq_featurehead_50k_50k_export/qat_static_imagenet_qonnx.onnx"
export INPUT_MODEL="full_siglip/build/static_qat_siglip2_86m_patch16_224_w6a7_qvlsq_featurehead_50k_50k_export_split_skipconv/convert_to_hw_shuffle.onnx"

export CLOCK_NS="3.999"
export TARGET_FPS="1200"
export LOOP_TARGET_FPS="120"
export MVAU_WWIDTH_MAX="72"
export MVAU_HLS_NODES="MVAU_0,MVAU_97,MVAU_98"
export SIGLIP2_86M_STREAM_FEEDBACK="1"

export FOLDING_CONFIG_FILE="full_siglip/configs/siglip2_86m_w6a7_qvlsq_sub30_unpump3top234loop4_folding.json"
export FOLDING_CONFIG="${FOLDING_CONFIG_FILE}"
export MVAU_PUMPED_EXCLUDE_NODES="MVAU_rtl_2,MVAU_rtl_3,MVAU_rtl_4,FINNLoop_0_body_FINNLoop_0_MVAU_rtl_3,FINNLoop_0_body_FINNLoop_0_MVAU_rtl_4"

export EST_DIR="full_siglip/build/static_qat_siglip2_86m_patch16_224_w6a7_qvlsq_featurehead_50k_50k_export_mlo_fps1200_loopfps120_w72_hlstop_stream_feedback_outershuffle12_bits_sub30_unpump3top234loop4_est"
export DCP_SUFFIX="dcp_250p06mhz_sub30_unpump3top234loop4"
export DCP_DIR="full_siglip/build/static_qat_siglip2_86m_patch16_224_w6a7_qvlsq_featurehead_50k_50k_export_mlo_fps1200_loopfps120_w72_hlstop_stream_feedback_outershuffle12_bits_sub30_unpump3top234loop4_dcp_250p06mhz_sub30_unpump3top234loop4"

export FINN_VIVADO_ROUTE_DIRECTIVE="Explore"
export FINN_VIVADO_PHYS_OPT_DIRECTIVE="AggressiveExplore"
export FINN_VIVADO_POST_ROUTE_PHYS_OPT_DIRECTIVE="ExploreWithAggressiveHoldFix"
export POSTROUTE_RECOVERY="1"
export POSTROUTE_PHYS_OPT_DIRECTIVE="ExploreWithAggressiveHoldFix"
export POSTROUTE_ROUTE_DIRECTIVE="Explore"
export POSTROUTE_FINAL_PHYS_OPT_DIRECTIVE="ExploreWithAggressiveHoldFix"
